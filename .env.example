PORT=3000
DATABASE_PATH=./data/boltbounty.db
LND_REST_HOST=https://127.0.0.1:8082
LND_MACAROON_HEX=
LND_TLS_CERT_PATH=
BOUNTY_DEFAULT_EXPIRY_SECONDS=86400
HOLD_INVOICE_CLTV_EXPIRY=400

# Integration tests only (apps/api/test/*.live.test.ts). Paths to the poster
# and worker nodes' files from Polar; the API itself never uses these.
TEST_POSTER_REST_HOST=https://127.0.0.1:8081
TEST_POSTER_TLS_CERT_PATH=
TEST_POSTER_MACAROON_PATH=
TEST_WORKER_REST_HOST=https://127.0.0.1:8083
TEST_WORKER_TLS_CERT_PATH=
TEST_WORKER_MACAROON_PATH=

# GitHub sign-in (Settings > Developer settings > OAuth Apps). Callback URL is
# APP_URL/api/auth/github/callback. Leave blank to run in guest mode.
APP_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
